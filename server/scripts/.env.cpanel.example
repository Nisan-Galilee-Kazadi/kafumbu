# MySQL cPanel - Kafumbu Smart City
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=better_root
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=better_kafumbu_city

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=7d
EMAIL_TOKEN_SECRET=replace_with_a_long_random_email_token_secret

# SMTP pour la validation des inscriptions par e-mail
SMTP_HOST=mail.your-domain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=replace_me
SMTP_FROM="Kafumbu Smart City <no-reply@your-domain.com>"

# Server
PORT=4000
NODE_ENV=production

# CORS
CORS_ORIGIN=https://kafumbu.betterlife-ong.org,https://betterlife-ong.org,https://cpanel.betterlife-ong.org

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
