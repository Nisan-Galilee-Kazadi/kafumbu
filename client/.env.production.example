# PORT sera ignoré par Passenger sur cPanel, mais utile si lancé manuellement
PORT=4000

# Base de données MySQL
DB_HOST=localhost
DB_USER=nom_utilisateur_cpanel_bdd
DB_PASSWORD=mot_de_passe_fort
DB_NAME=nom_base_de_donnees

# Sécurité & JWT
# Utilisez une chaîne aléatoire très longue et unique
JWT_SECRET=remplacer_par_une_cle_secrete_longue_et_aleatoire
JWT_EXPIRY=7d
EMAIL_TOKEN_SECRET=remplacer_par_une_cle_secrete_longue_et_aleatoire

# CORS (Protection des domaines)
# Domaines autorisés séparés par des virgules (ex: https://kafumbu-smartcity.cd,https://www.kafumbu-smartcity.cd)
CORS_ORIGIN=https://kafumbu-smartcity.cd

# Email (SMTP pour envoi des codes OTP)
SMTP_HOST=mail.betterlife-ong.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@betterlife-ong.org
SMTP_PASS=BetterLife2025
SMTP_FROM="Kafumbu Smart City" <info@betterlife-ong.org>

# Administrateur Principal (utilisé pour les scripts de nettoyage ou droits par défaut)
PRIMARY_ADMIN_EMAIL=admin@kafumbu-smartcity.cd
